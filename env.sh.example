# source this in every shell:  source /NHNHOME/WORKSPACE/0526050025_A/alpamayo/env.sh
export BIG=/NHNHOME/WORKSPACE/0526050025_A/alpamayo   # lustre: code, dataset, checkpoints (persistent, shared across nodes)
export HF_HOME=/NHNHOME/hf-cache                      # local NVMe: re-downloadable
export UV_CACHE_DIR=/NHNHOME/uv-cache                 # local NVMe: regenerable
export HF_TOKEN=hf_your_token_here
export MPLCONFIGDIR=/tmp/alpamayo_mpl
# a venv is tens of thousands of small files, so keep it off lustre (uv.lock can rebuild it)
export UV_PROJECT_ENVIRONMENT=/NHNHOME/venvs/alpamayo1.5
unset VIRTUAL_ENV   # ignore a stale activate from a previous shell
export PATH="$HOME/.local/bin:${PATH:-}"
alias amcd='cd $BIG/alpamayo1.5'
export PYTHONPATH=$BIG/pyfix:${PYTHONPATH:-}   # workaround for dead huggingface.co CloudFront IPs
