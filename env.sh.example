# source this every shell:  source /NHNHOME/WORKSPACE/0526050025_A/alpamayo/env.sh
export BIG=/NHNHOME/WORKSPACE/0526050025_A/alpamayo   # lustre: 코드/데이터셋/체크포인트 (영구, 노드공유)
export HF_HOME=/NHNHOME/hf-cache                      # local NVMe: 재다운로드 가능
export UV_CACHE_DIR=/NHNHOME/uv-cache                 # local NVMe: 재생성 가능
export HF_TOKEN=hf_your_token_here
export MPLCONFIGDIR=/tmp/alpamayo_mpl
# venv는 소파일 수만 개 -> lustre 금지, 로컬 NVMe에 둔다 (uv.lock으로 재생성 가능)
export UV_PROJECT_ENVIRONMENT=/NHNHOME/venvs/alpamayo1.5
unset VIRTUAL_ENV   # 이전 셸의 stale activate 무시
export PATH="$HOME/.local/bin:$PATH"
alias amcd='cd $BIG/alpamayo1.5'
export PYTHONPATH=$BIG/pyfix:$PYTHONPATH   # huggingface.co 죽은 CloudFront IP 우회
